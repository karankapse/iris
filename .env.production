# Settings for the DEPLOYED frontend (Vercel build). PUBLIC values only: everything here ends up in
# the JavaScript anyone can download. Secrets (API keys, passwords) belong in the backend's host.
VITE_MOCK_EYE=0
VITE_MOCK_EMOTION=0
VITE_MOCK_CONVERSATION=0
VITE_STT_PROVIDER=auto
VITE_TTS_PROVIDER=cloned
# the backend on Railway (live speech streams connect to it directly)
VITE_BACKEND_URL=https://RAILWAY_BACKEND_URL
