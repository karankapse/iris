# Settings for the DEPLOYED frontend (Vercel build). PUBLIC values only: everything here ends up in
# the JavaScript anyone can download. Secrets (API keys, passwords) go in Vercel's Environment
# Variables, where only the backend function can read them.
VITE_MOCK_EYE=0
VITE_MOCK_EMOTION=0
VITE_MOCK_CONVERSATION=0
# Vercel can't hold Muse's live stream open, so the deployed site uses Chrome's speech recognition
VITE_STT_PROVIDER=webspeech
VITE_TTS_PROVIDER=cloned
