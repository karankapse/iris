# Copy to `.env` (done by `make setup`) and fill in. `.env` is git-ignored: NEVER commit real keys.

# --- Backend ---------------------------------------------------------------
# Get a key at https://console.anthropic.com/ . Leave empty to use canned (mock) suggestions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Set to true to force canned suggestions even when a key is present.
MOCK_LLM=false

# --- Frontend (only VITE_* variables are visible to the browser) --------------
# Each module can be mocked (1, the default) or real (0). Mocks need no camera/mic/API.
VITE_MOCK_EYE=1
VITE_MOCK_EMOTION=1
VITE_MOCK_STT=1
VITE_MOCK_CONVERSATION=1
# 'browser' = speechSynthesis voice (default), 'silent' = no sound
VITE_TTS_PROVIDER=browser
