# Copy to `.env` (done by `make setup`) and fill in. `.env` is git-ignored: NEVER commit real keys.

# --- Backend ---------------------------------------------------------------
# Get a key at https://console.anthropic.com/ . Leave empty to use canned (mock) suggestions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Set to true to force canned suggestions even when a key is present.
MOCK_LLM=false

# Meta "Muse Voice Transcribe" speech-to-text. Create a key in the Meta Model API dashboard
# (https://dev.meta.ai). It lives ONLY on the backend: the browser streams audio to our
# backend, which forwards it to Meta. Leave empty to run without a microphone.
MODEL_API_KEY=
# To develop without a key: run `uv run python -m scripts.fake_muse_server` (in backend/)
# and set MODEL_API_KEY=fake and MUSE_URL=ws://localhost:9000
# MUSE_URL=wss://api.meta.ai/v1/asr/realtime
# Set true if Meta rejects the handshake (close code 1008): sends "Bearer <key>".
# MUSE_BEARER_PREFIX=false
# Log raw Muse events (includes transcripts). Debugging only.
# STT_DEBUG=false

# ElevenLabs Voice Cloning & Emotional TTS (https://elevenlabs.io)
# API key lives ONLY on the backend. Used for cloning user's voice and expressive TTS.
ELEVENLABS_API_KEY=
# Default or pre-cloned voice ID (can also be set/cloned via Iris Set up UI)
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Frontend (only VITE_* variables are visible to the browser) --------------
# REAL mode is the default: real camera (face tracking + eye control), real microphone.
# For any module, switch back to the mock to work without hardware / API keys:
#   VITE_MOCK_EYE=1      keyboard plays the eyes (arrows, Space, Enter, Esc)
#   VITE_MOCK_EMOTION=1  pick the "detected" emotion in the Dev Panel
#   VITE_STT_PROVIDER=mock   type what the partner says in the Dev Panel
VITE_MOCK_EYE=0
VITE_MOCK_EMOTION=0
# Where the partner's speech comes from: auto (Muse if MODEL_API_KEY is set, else Chrome), muse, webspeech
# (Chrome built-in; audio goes to Google), or mock.
VITE_STT_PROVIDER=auto
# 0 = get suggestions from the backend (Claude, or canned replies without an Anthropic key)
VITE_MOCK_CONVERSATION=0
# Screen gaze for "Look at an option" mode: mediapipe (default, iris-based), webgazer, or mouse (development). Glance mode (the default) needs neither.
VITE_GAZE_ENGINE=mediapipe
# 'cloned' = ElevenLabs cloned voice with emotion sliders (default), 'browser' = speechSynthesis, 'silent' = no sound
VITE_TTS_PROVIDER=cloned
