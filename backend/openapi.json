{
  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "token": {
            "description": "Send as 'Authorization: Bearer <token>'",
            "title": "Token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          }
        },
        "required": [
          "token",
          "user"
        ],
        "title": "AuthResponse",
        "type": "object"
      },
      "Body_clone_voice_api_voice_clone_post": {
        "properties": {
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "user_id": {
            "default": "local-user",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "name",
          "file"
        ],
        "title": "Body_clone_voice_api_voice_clone_post",
        "type": "object"
      },
      "ConversationTurn": {
        "properties": {
          "speaker": {
            "enum": [
              "partner",
              "user"
            ],
            "title": "Speaker",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "speaker",
          "text"
        ],
        "title": "ConversationTurn",
        "type": "object"
      },
      "EmotionModel": {
        "description": "A trained logistic-regression model, exported so the browser can run it locally.\n\nPrediction in the browser:\n    x_scaled = (x - means) / scales\n    logits[c] = sum_j(coef[c][j] * x_scaled[j]) + intercept[c]\n    probabilities = softmax(logits)",
        "properties": {
          "accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cross-validated accuracy (0.0 to 1.0), or None if not enough data to measure.",
            "title": "Accuracy"
          },
          "classes": {
            "items": {
              "enum": [
                "neutral",
                "happy",
                "sad",
                "excited",
                "joking",
                "serious"
              ],
              "type": "string"
            },
            "title": "Classes",
            "type": "array"
          },
          "coefs": {
            "description": "Weight matrices for each layer",
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            "title": "Coefs",
            "type": "array"
          },
          "feature_names": {
            "items": {
              "type": "string"
            },
            "title": "Feature Names",
            "type": "array"
          },
          "intercepts": {
            "description": "Bias vectors for each layer",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Intercepts",
            "type": "array"
          },
          "means": {
            "items": {
              "type": "number"
            },
            "title": "Means",
            "type": "array"
          },
          "n_samples": {
            "title": "N Samples",
            "type": "integer"
          },
          "scales": {
            "items": {
              "type": "number"
            },
            "title": "Scales",
            "type": "array"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "feature_names",
          "classes",
          "means",
          "scales",
          "coefs",
          "intercepts",
          "n_samples"
        ],
        "title": "EmotionModel",
        "type": "object"
      },
      "EmotionSample": {
        "properties": {
          "features": {
            "description": "Same order as `feature_names` in the request",
            "items": {
              "type": "number"
            },
            "title": "Features",
            "type": "array"
          },
          "label": {
            "enum": [
              "neutral",
              "happy",
              "sad",
              "excited",
              "joking",
              "serious"
            ],
            "title": "Label",
            "type": "string"
          },
          "source": {
            "default": "calibration",
            "enum": [
              "calibration",
              "feedback"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "label",
          "features"
        ],
        "title": "EmotionSample",
        "type": "object"
      },
      "FeedbackRequest": {
        "description": "One piece of feedback about a spoken reply.\n\nThe user's eye yes/no and the partner's tap arrive at different moments, so both\nfields are optional; send whichever one you have. `utterance_id` ties them together.",
        "properties": {
          "feature_names": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feature Names"
          },
          "features": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Face-feature snapshot taken when the tone was suggested",
            "title": "Features"
          },
          "partner_reaction": {
            "anyOf": [
              {
                "enum": [
                  "understood",
                  "seemed_off"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Partner Reaction"
          },
          "reply_text": {
            "title": "Reply Text",
            "type": "string"
          },
          "spoken_tone": {
            "enum": [
              "neutral",
              "happy",
              "sad",
              "excited",
              "joking",
              "serious"
            ],
            "title": "Spoken Tone",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          },
          "user_tone_ok": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "description": "User's eye yes/no",
            "title": "User Tone Ok"
          },
          "utterance_id": {
            "title": "Utterance Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "utterance_id",
          "reply_text",
          "spoken_tone"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "SamplesRequest": {
        "properties": {
          "feature_names": {
            "items": {
              "type": "string"
            },
            "title": "Feature Names",
            "type": "array"
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/EmotionSample"
            },
            "title": "Samples",
            "type": "array"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "feature_names",
          "samples"
        ],
        "title": "SamplesRequest",
        "type": "object"
      },
      "SelectVoiceRequest": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "user_id": {
            "default": "local-user",
            "title": "User Id",
            "type": "string"
          },
          "voice_id": {
            "title": "Voice Id",
            "type": "string"
          }
        },
        "required": [
          "voice_id"
        ],
        "title": "SelectVoiceRequest",
        "type": "object"
      },
      "SignupRequest": {
        "properties": {
          "email": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "name": {
            "description": "The person who will use Iris",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 200,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "name"
        ],
        "title": "SignupRequest",
        "type": "object"
      },
      "SpeakRequest": {
        "properties": {
          "emotion": {
            "default": "neutral",
            "enum": [
              "neutral",
              "happy",
              "sad",
              "excited",
              "joking",
              "serious"
            ],
            "title": "Emotion",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "user_id": {
            "default": "local-user",
            "title": "User Id",
            "type": "string"
          },
          "voice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Id"
          }
        },
        "required": [
          "text"
        ],
        "title": "SpeakRequest",
        "type": "object"
      },
      "Suggestion": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "text": {
            "description": "A short reply the user could say, in first person",
            "title": "Text",
            "type": "string"
          },
          "tone": {
            "description": "The emotional tone this reply is best spoken with",
            "enum": [
              "neutral",
              "happy",
              "sad",
              "excited",
              "joking",
              "serious"
            ],
            "title": "Tone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "tone"
        ],
        "title": "Suggestion",
        "type": "object"
      },
      "SuggestionsRequest": {
        "properties": {
          "history": {
            "description": "Oldest first; last turn is usually the partner",
            "items": {
              "$ref": "#/components/schemas/ConversationTurn"
            },
            "title": "History",
            "type": "array"
          },
          "mood": {
            "anyOf": [
              {
                "enum": [
                  "neutral",
                  "happy",
                  "sad",
                  "excited",
                  "joking",
                  "serious"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The user's persistent mood setting, if any",
            "title": "Mood"
          },
          "profile": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserProfile"
              },
              {
                "type": "null"
              }
            ],
            "description": "Who the user is, so replies feel personal"
          },
          "reaction": {
            "anyOf": [
              {
                "enum": [
                  "neutral",
                  "happy",
                  "sad",
                  "excited",
                  "joking",
                  "serious"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The user's immediate emotional reaction / facial expression to what was said",
            "title": "Reaction"
          }
        },
        "required": [
          "history"
        ],
        "title": "SuggestionsRequest",
        "type": "object"
      },
      "SuggestionsResponse": {
        "properties": {
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "suggestions"
        ],
        "title": "SuggestionsResponse",
        "type": "object"
      },
      "TrainRequest": {
        "properties": {
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id"
        ],
        "title": "TrainRequest",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "UserProfile": {
        "description": "Optional info that makes suggestions feel personal, plus the quick-access phrases.",
        "properties": {
          "common_needs": {
            "description": "e.g. \"water\", \"pillow\"",
            "items": {
              "type": "string"
            },
            "title": "Common Needs",
            "type": "array"
          },
          "interests": {
            "items": {
              "type": "string"
            },
            "title": "Interests",
            "type": "array"
          },
          "name": {
            "default": "",
            "title": "Name",
            "type": "string"
          },
          "phrases": {
            "description": "Quick-access phrases",
            "items": {
              "type": "string"
            },
            "title": "Phrases",
            "type": "array"
          },
          "relationships": {
            "description": "e.g. \"daughter Maya\"",
            "items": {
              "type": "string"
            },
            "title": "Relationships",
            "type": "array"
          }
        },
        "title": "UserProfile",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VoiceItem": {
        "properties": {
          "is_default": {
            "default": false,
            "title": "Is Default",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "voice_id": {
            "title": "Voice Id",
            "type": "string"
          }
        },
        "required": [
          "voice_id",
          "name"
        ],
        "title": "VoiceItem",
        "type": "object"
      },
      "VoiceProfileResponse": {
        "properties": {
          "configured": {
            "title": "Configured",
            "type": "boolean"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          },
          "voice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Id"
          },
          "voices": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/VoiceItem"
            },
            "title": "Voices",
            "type": "array"
          }
        },
        "required": [
          "user_id",
          "voice_id",
          "name",
          "configured"
        ],
        "title": "VoiceProfileResponse",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Iris API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout_api_auth_logout_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "me_api_auth_me_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/signup": {
      "post": {
        "operationId": "signup_api_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Signup",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/emotion/model/{user_id}": {
      "get": {
        "operationId": "get_model_api_emotion_model__user_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "required": true,
