          "user_id": {
            "title": "User Id",
            "type": "string"
          },
          "voice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Id"
          },
          "voices": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/VoiceItem"
            },
            "title": "Voices",
            "type": "array"
          }
        },
        "required": [
          "user_id",
          "voice_id",
          "name",
          "configured"
        ],
        "title": "VoiceProfileResponse",
        "type": "object"
      }
    }
  },
