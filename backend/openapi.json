          }
        },
        "required": [
          "name",
          "file"
        ],
        "title": "Body_clone_voice_api_voice_clone_post",
        "type": "object"
      },
      "ConversationEmotion": {
        "description": "How this moment feels, judged from the partner's words AND the user's face.",
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "emotion": {
            "enum": [
              "neutral",
              "happy",
              "sad",
              "excited",
              "joking",
              "serious"
            ],
            "title": "Emotion",
            "type": "string"
          },
          "reason": {
            "default": "",
            "description": "Short: why (and any words/face disagreement)",
            "title": "Reason",
            "type": "string"
          },
          "source": {
            "default": "face + words",
            "enum": [
              "face",
              "words",
              "face + words"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "emotion",
          "confidence"
        ],
        "title": "ConversationEmotion",
        "type": "object"
      },
      "ConversationTurn": {
        "properties": {
          "speaker": {
            "enum": [
              "partner",
              "user"
            ],
            "title": "Speaker",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "speaker",
          "text"
        ],
        "title": "ConversationTurn",
        "type": "object"
      },
      "EmotionModel": {
        "description": "A trained logistic-regression model, exported so the browser can run it locally.\n\nPrediction in the browser:\n    x_scaled = (x - means) / scales\n    logits[c] = sum_j(coef[c][j] * x_scaled[j]) + intercept[c]\n    probabilities = softmax(logits)",
        "properties": {
          "accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Average per-emotion accuracy on held-out recordings",
            "title": "Accuracy"
          },
          "advice": {
            "description": "e.g. \"sad needs more examples (record it again)\"",
            "items": {
              "type": "string"
            },
            "title": "Advice",
            "type": "array"
          },
          "classes": {
            "items": {
              "enum": [
                "neutral",
                "happy",
                "sad",
                "excited",
                "joking",
                "serious"
              ],
              "type": "string"
            },
            "title": "Classes",
            "type": "array"
          },
          "coef": {
            "description": "shape: [len(classes)][len(feature_names)]",
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "title": "Coef",
            "type": "array"
          },
          "feature_names": {
            "items": {
              "type": "string"
            },
            "title": "Feature Names",
            "type": "array"
          },
          "intercept": {
            "items": {
              "type": "number"
            },
            "title": "Intercept",
            "type": "array"
          },
          "means": {
            "items": {
              "type": "number"
            },
            "title": "Means",
            "type": "array"
          },
          "n_samples": {
            "title": "N Samples",
            "type": "integer"
          },
          "per_class_accuracy": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "enum": [
                "neutral",
                "happy",
                "sad",
                "excited",
                "joking",
                "serious"
              ]
            },
            "title": "Per Class Accuracy",
            "type": "object"
          },
          "scales": {
            "items": {
              "type": "number"
            },
            "title": "Scales",
            "type": "array"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "feature_names",
          "classes",
          "means",
          "scales",
          "coef",
          "intercept",
          "n_samples"
        ],
        "title": "EmotionModel",
        "type": "object"
      },
      "EmotionSample": {
        "properties": {
